  "cards": [
    {
      "dot": "cyan",
      "title": "当前与规划如何区分",
      "items": [
        "上方来自现有工作区配置核对；当前只有文章查询业务。",
        "下方是尚未部署的独立 RDS 方案，采购与预算仍待确定。",
        "工作区尚无 Git 提交快照，图中不提供提交级源码引用。"
      ]
    },
    {
      "dot": "emerald",
      "title": "连接与数据归属",
      "items": [
        "浏览器通过 HTTP / JSON 调用后端，不连接 MySQL。",
        "云端 Java 使用 RDS 内网地址，ECS 与 RDS 选择同地域同 VPC，并配置访问白名单。",
        "DB_URL、DB_USERNAME、DB_PASSWORD 只交给后端；MySQL 保存业务记录及文件元数据。"
      ]
    },
    {
      "dot": "violet",
      "title": "后续扩展位置",
      "items": [
        "OSS：接入授权的图片、音频后再增加；图中只显示后端存取关系。",
        "Redis：有缓存或共享状态需求时增加；当前未接入。",
        "检索与向量索引：可信资料和 RAG 需求形成后再选型。",
        "耗时任务：资料整理和 Agent 执行需要持久化状态，再考虑独立 Worker 与队列。"
      ]
    },
    {
      "dot": "amber",
      "title": "运行与上线配置",
      "items": [
        "域名解析到入口地址，HTTPS 证书由入口使用；具体域名与上线配置尚未完成。",
        "后台写入需要认证、权限和审核流程；现有读取接口尚未实现这些能力。",
        "监控覆盖应用错误、数据库连接和磁盘等；备份需要设置保留与恢复验证。",
        "云端连接、HTTPS、Nginx 和 OSS 均为方案，不能视为已完成的部署。"
      ]
    }
  ]
