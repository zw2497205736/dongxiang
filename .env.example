# 本地 scripts/mysql.sh start 会自动生成 .env，无需复制这个示例。
# 手动连接已有开发数据库时，可以按以下格式填写 .env。
# 云端 systemd 使用 deploy/aliyun/backend.env.example，格式与用途见该目录 README。
DB_URL='jdbc:mysql://127.0.0.1:3307/dongxiang_culture?characterEncoding=UTF-8&connectionTimeZone=UTC'
DB_USERNAME='dongxiang'
DB_PASSWORD='REPLACE_WITH_DEVELOPMENT_PASSWORD'
