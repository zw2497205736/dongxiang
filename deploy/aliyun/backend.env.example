# 示例格式：systemd EnvironmentFile；实际文件放在 ECS 的 /etc/dongxiang/backend.env。
# 将 RDS 地址、端口、库名和账号替换为实际值。密码只填写在服务器上的实际文件。
DB_URL=jdbc:mysql://REPLACE_WITH_RDS_INTERNAL_HOST:3306/dongxiang_culture?characterEncoding=UTF-8&connectionTimeZone=UTC
DB_USERNAME=REPLACE_WITH_APP_ACCOUNT
DB_PASSWORD=REPLACE_ON_SERVER
BACKEND_PORT=8080
DB_POOL_MAX=5
